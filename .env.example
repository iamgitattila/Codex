# Sora Video Link Automation - Environment Configuration

# ============================================================================
# OPTION 1: Public Sora Showcase Page
# ============================================================================
# URL of the Sora showcase page to scrape
SORA_URL=https://openai.com/sora/

# ============================================================================
# OPTION 2: Personal Sora Profile (Real-time Monitoring)
# ============================================================================
# Your personal Sora profile URL
SORA_PROFILE_URL=https://sora.chatgpt.com/profile/iamattila

# Path to cookies file for authentication (generated after first login)
COOKIES_FILE=sora_cookies.json

# Polling interval in seconds (default: 60, minimum: 30)
POLL_INTERVAL=60

# ============================================================================
# Google Sheets Configuration (Required for both options)
# ============================================================================
# Path to Google service account credentials JSON file
GOOGLE_CREDENTIALS_PATH=credentials.json

# Google Sheets spreadsheet ID (found in the spreadsheet URL)
# Example: https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the sheet tab where video links will be saved
SHEET_NAME=Sora Videos
