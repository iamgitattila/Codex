STRIPE_STARTER_PRICE_ID_ANNUAL=price_xxx
STRIPE_GROWTH_PRICE_ID_MONTHLY=price_xxx
STRIPE_GROWTH_PRICE_ID_ANNUAL=price_xxx
STRIPE_PRO_PRICE_ID_MONTHLY=price_xxx
STRIPE_PRO_PRICE_ID_ANNUAL=price_xxx

# JWT Configuration
